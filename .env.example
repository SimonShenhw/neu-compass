# Copy to .env and fill in. NEVER commit .env.
# Each team member has their own keys - do not share.

# === LLM ===
GEMINI_API_KEY=your_gemini_key_here

# === Reddit (PRAW) ===
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=neu-compass/0.1 by your_username

# === Google OAuth (Week 6) ===
GOOGLE_OAUTH_CLIENT_ID=your_oauth_client_id
GOOGLE_OAUTH_CLIENT_SECRET=your_oauth_client_secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8501/oauth/callback

# === Storage paths ===
# WSL2 推荐路径（性能更好）
SQLITE_PATH=./data/courses.db
FAISS_INDEX_PATH=./data/faiss_index

# Completed-answer storage and votes: OFF until privacy/release review.
# Even when enabled, /chat requires allow_feedback_capture=true per request.
# Restart API and UI together. Disabling does NOT delete DB/backups/exports.
ANSWER_FEEDBACK_ENABLED=false

# query_log text older than this many days becomes its keyed hash, and saved answers that old are
# deleted with their votes; 0 = off. Needs SESSION_SECRET. The API does it at startup and then
# daily (docs/query-log-export.md, 到期清理). The UI reads the same value for its 数据与隐私 page,
# so set it for both services.
QUERY_LOG_RETENTION_DAYS=0

# Gemini calls (chat answers + HyDE rescues) allowed per UTC day; 0 = no cap. Counted in
# model_budget.json next to the database; one API process only.
MODEL_DAILY_CALL_LIMIT=0

# Shown on the 数据与隐私 page for questions and deletion requests; unset hides the line.
# PRIVACY_CONTACT_EMAIL=

# Optional single-process POST /search + /chat admission; OFF, not calibrated.
# No per-user/IP identity or multi-worker/shared budget. Review before enabling.
# Runtime .env is NOT changed by adding this example. Restart API to apply.
REQUEST_GUARD_ENABLED=false
REQUEST_GUARD_CAPACITY=8
REQUEST_GUARD_REFILL_PER_SECOND=1.0
REQUEST_GUARD_MAX_INFLIGHT=2

# Optional read-only policy evidence overrides. Never auto-fetches missing files.
# Bundle defaults to the packaged 2026-2027 sample; archive directories default
# to <SQLITE_PATH parent>/raw/program_policy_catalog and /raw/program_catalog.
# PROGRAM_POLICY_BUNDLE_PATH=/data/program-policy/evidence.json
# PROGRAM_POLICY_SOURCE_DIR=/data/raw/program_policy_catalog
# PROGRAM_CATALOG_SOURCE_DIR=/data/raw/program_catalog

# === API base URL (Streamlit calls FastAPI here) ===
API_BASE_URL=http://localhost:8000

# === Public UI origin (only used to BUILD ?course= / ?program= share links) ===
# 生产环境填公网地址，例如 https://compass.neu-compass.me
PUBLIC_BASE_URL=http://localhost:8501

# === Embedding ===
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cuda

# === Logging ===
LOG_LEVEL=INFO
LOG_FORMAT=json

# === API budget alarm (USD/month) ===
API_BUDGET_ALARM=150

# ADR-0021 session tokens (empty = auth disabled, anonymous browsing only)
# generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
